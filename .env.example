# ============================================
# AGENTE SNIPER - MODELO DE CONFIGURAÇÃO (.env.example)
# Copie este arquivo como .env e preencha suas chaves
# ============================================

# --- Provedores de Inteligência Artificial ---
# Google Gemini (Recomendado / Principal)
GEMINI_API_KEY=

# Groq (Opcional / Fallback)
CHAVE_GROQ=
USAR_GROQ=0

# Ollama Local (Opcional - ex: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODELO=gemma3:4b

# Outros Provedores de IA (Diagnóstico / Ferramentas)
CHAVE_OPENROUTER=
CHAVE_CEREBRAS=

# --- Busca na Web ---
# Tavily Search API (Principal)
CHAVE_TAVILY=
USAR_TAVILY=1

# DuckDuckGo (Opcional - default 0 por rate limits)
USAR_DDG=0

# Google News RSS (Gratuito / Notícias locais)
USAR_GOOGLE_NEWS_RSS=1

# --- Parâmetros da Empresa e Mercado ---
EMPRESA_ALVO=Supermercado Carvalho
CIDADE=Teresina
ESTADO=PI
PAIS=Brasil
NICHO=supermercado
CONCORRENTES=Mateus|Assai|Atacadao|R Carvalho

# --- Navegador / Playwright ---
USAR_PLAYWRIGHT=0

# --- Persistência e Resultados ---
PASTA_RESULTADOS=sniper_resultados
SNIPER_DB=sniper_resultados/sniper_historico.sqlite3

# --- Configuração de E-mail (Opcional / tools/enviar_email.py) ---
EMAIL_REMETENTE=
SENHA_APP_EMAIL=
EMAIL_DESTINATARIO=
